APP_NAME=nexalens
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexalens
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Vector DB (Chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=nexalens_docs

# Local LLM (Ollama)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW=8192

# Text-to-SQL
SQL_DIALECT=postgresql
SQL_MAX_ROWS=1000
SQL_TIMEOUT=30

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_DOC_SIZE_MB=50
SUPPORTED_EXTENSIONS=.pdf,.txt,.md,.csv,.xlsx,.docx

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# Auth
SECRET_KEY=dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090